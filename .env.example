# TerraFix dashboard / Vercel
# Use a pooled PostgreSQL/Neon connection string in production.
DATABASE_URL=""

# Canonical public HTTPS origin. Local HTTP is accepted only for localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Generate a unique server-side session secret: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# GitHub App identity, OAuth credentials, and signing material.
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_SLUG=""
# Store the PEM as one line with literal \n sequences in managed environment variables.
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# Server-only AWS control-plane identity. Production should use workload IAM.
AWS_CONTROL_PLANE_REGION="us-east-1"
AWS_ASSUME_ROLE_PRINCIPAL_ARN=""

# Optional build metadata; a Vercel Git SHA is used automatically when available.
TERRAFIX_BUILD_SHA=""

# Model catalog bootstrap/sync command and hosted worker
# The service owns this key. Never add it to a consumer repository or NEXT_PUBLIC_*.
OPENROUTER_API_KEY=""
# Optional only for legacy Gemini-configured runs.
GEMINI_API_KEY=""

# TerraFix worker
SEMANTIC_TERRAFORM_AGENT_VERSION="1.1.4"
# Optional local override when the CLI is outside PATH.
SEMANTIC_TERRAFORM_AGENT_COMMAND=""
WORKER_POLL_INTERVAL_MS="5000"
WORKER_JOB_TIMEOUT_SECONDS="600"

# Do not add long-lived AWS keys here. Use workload identity, AWS SSO, or the
# standard SDK credential provider chain outside this repository.
