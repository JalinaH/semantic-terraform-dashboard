# Required for authenticated sessions and the PostgreSQL-backed hosted job queue.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/semantic_terraform_dashboard?schema=public"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Used server-side as the validated canonical origin for PR comment links.

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# GitHub App identity and user authorization (OAuth) credentials.
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
# Prefer the slug only, for example: semantic-terraform-agent-dev
# A copied https://github.com/apps/... or https://github.com/settings/apps/... URL is also normalized safely.
GITHUB_APP_SLUG=""

# Keep the literal \n sequences when storing the PEM on one line.
# The server converts them back to line breaks before signing app JWTs.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_ME\n-----END RSA PRIVATE KEY-----"

# Must match the GitHub App webhook secret. Used only for raw-body HMAC verification.
GITHUB_WEBHOOK_SECRET=""

# Server-only AWS control-plane identity used to assume repository-scoped
# customer roles. Production should obtain credentials from its workload IAM
# role. Local development uses the standard AWS SDK credential provider chain.
AWS_CONTROL_PLANE_REGION="us-east-1"
AWS_ASSUME_ROLE_PRINCIPAL_ARN="arn:aws:iam::111122223333:role/SemanticTerraformAgentControlPlane"

# Do not add AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY to this product file.
# If local verification is needed, configure the normal shared AWS profile,
# AWS SSO, or another standard SDK credential provider outside the repository.

# Hosted worker model credential. It belongs to the service, never a customer repository.
GEMINI_API_KEY=""

# Keep production pinned to an immutable version, tag, or commit.
SEMANTIC_TERRAFORM_AGENT_VERSION="git+https://github.com/JalinaH/semantic-terraform-agent.git@12b9c7a1755921d2e3fea18f8b96eece8e61841f"
WORKER_POLL_INTERVAL_MS="5000"
WORKER_JOB_TIMEOUT_SECONDS="600"
