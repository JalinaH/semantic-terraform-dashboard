generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  USER
  ORGANIZATION
}

enum RepositorySelection {
  ALL
  SELECTED
}

enum RepositoryContextMode {
  AUTO
  LIGHTWEIGHT
  SCHEMA_AWARE
}

enum ModelProvider {
  GEMINI
  OPENROUTER
}

enum UserAccessLevel {
  FREE
  PRO
  ADVANCED
}

enum ModelTier {
  FREE
  ECONOMY
  BALANCED
  PREMIUM
}

enum ModelRouting {
  AUTO
  FIXED
}

enum FailureStage {
  VALIDATE
  PLAN
}

enum AWSConnectionStatus {
  PENDING
  CONNECTED
  VERIFICATION_FAILED
  ACCESS_REMOVED
}

enum AwsOnboardingSessionStatus {
  PENDING
  STACK_LAUNCHED
  CALLBACK_RECEIVED
  VERIFYING
  CONNECTED
  EXPIRED
  FAILED
}

enum VerificationStatus {
  VERIFIED_FIRST_ATTEMPT
  VERIFIED_AFTER_RETRY
  VERIFICATION_FAILED
  PATCH_REJECTED
  VERIFICATION_UNAVAILABLE
  VERIFICATION_SKIPPED
  PENDING
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
}

enum WebhookDeliveryStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum PublicationStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  SKIPPED
}

enum PatchApplicationStatus {
  PENDING
  APPLYING
  APPLIED
  STALE
  REJECTED
  FAILED
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  image                 String?
  githubUserId          String?                @unique
  githubLogin           String?
  avatarUrl             String?
  accessLevel           UserAccessLevel        @default(FREE)
  accounts              Account[]
  sessions              Session[]
  userInstallations     UserInstallation[]
  patchApplications     PatchApplication[]
  awsOnboardingSessions AwsOnboardingSession[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([githubLogin])
}

model GitHubInstallation {
  id                     String                 @id @default(cuid())
  installationId         String                 @unique
  accountId              String?
  accountLogin           String
  accountType            AccountType
  repositorySelection    RepositorySelection
  htmlUrl                String?
  suspendedAt            DateTime?
  pullRequestsPermission String?
  contentsPermission     String?
  userInstallations      UserInstallation[]
  repositories           Repository[]
  agentRuns              AgentRun[]
  awsOnboardingSessions  AwsOnboardingSession[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([accountId])
  @@index([accountLogin])
}

model UserInstallation {
  id                   String             @id @default(cuid())
  userId               String
  githubInstallationId String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubInstallation   GitHubInstallation @relation(fields: [githubInstallationId], references: [id], onDelete: Cascade)
  lastVerifiedAt       DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([userId, githubInstallationId])
  @@index([githubInstallationId])
}

model Repository {
  id                    String                 @id @default(cuid())
  githubRepositoryId    String                 @unique
  owner                 String
  name                  String
  fullName              String                 @unique
  defaultBranch         String                 @default("main")
  private               Boolean                @default(false)
  archived              Boolean                @default(false)
  accessible            Boolean                @default(true)
  removedAt             DateTime?
  installationId        String
  installation          GitHubInstallation     @relation(fields: [installationId], references: [id], onDelete: Cascade)
  config                RepositoryConfig?
  awsConnection         AWSConnection?
  awsOnboardingSessions AwsOnboardingSession[]
  agentRuns             AgentRun[]
  publications          AgentRunPublication[]
  webhookDeliveries     WebhookDelivery[]
  patchApplications     PatchApplication[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([installationId])
  @@index([installationId, accessible])
  @@index([owner, name])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model RepositoryConfig {
  id                    String                @id @default(cuid())
  repositoryId          String                @unique
  repository            Repository            @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  enabled               Boolean               @default(true)
  terraformDir          String                @default(".")
  terraformVersion      String                @default("1.15.7")
  modelProvider         ModelProvider         @default(GEMINI)
  model                 String                @default("gemini-3.6-flash")
  modelRouting          ModelRouting          @default(FIXED)
  maxModelTier          ModelTier             @default(FREE)
  fixedModelId          String?
  modelPolicyVersion    String                @default("legacy_phase8")
  accessLevelSnapshot   UserAccessLevel       @default(FREE)
  contextMode           RepositoryContextMode @default(AUTO)
  maxRepairAttempts     Int                   @default(1)
  triggerOnPullRequest  Boolean               @default(true)
  triggerOnPush         Boolean               @default(true)
  failedStages          FailureStage[]        @default([PLAN])
  workflowNames         String[]              @default(["Terraform", "Terraform CI", "Infrastructure Plan"])
  workflowNamePatterns  String[]              @default([])
  terraformPathPatterns String[]              @default(["**/*.tf", "**/*.tf.json"])
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model AWSConnection {
  id                String              @id @default(cuid())
  repositoryId      String              @unique
  repository        Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  roleArn           String?
  region            String
  status            AWSConnectionStatus @default(PENDING)
  externalId        String              @unique
  awsAccountId      String?
  lastVerifiedAt    DateTime?
  verificationError String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status])
  @@index([awsAccountId])
}

model AwsOnboardingSession {
  id                 String                     @id @default(cuid())
  repositoryId       String
  repository         Repository                 @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  userId             String
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId     String
  installation       GitHubInstallation         @relation(fields: [installationId], references: [id], onDelete: Cascade)
  externalId         String                     @unique
  callbackTokenHash  String                     @unique
  region             String
  status             AwsOnboardingSessionStatus @default(PENDING)
  expiresAt          DateTime
  callbackReceivedAt DateTime?
  completedAt        DateTime?
  roleArn            String?
  awsAccountId       String?
  failureCode        String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([repositoryId, createdAt])
  @@index([userId, repositoryId])
  @@index([status, expiresAt])
}

model AgentRun {
  id                               String                @id @default(cuid())
  repositoryId                     String
  repository                       Repository            @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  githubInstallationId             String
  githubInstallation               GitHubInstallation    @relation(fields: [githubInstallationId], references: [id], onDelete: Cascade)
  githubEventType                  String
  githubDeliveryId                 String                @unique
  delivery                         WebhookDelivery       @relation(fields: [githubDeliveryId], references: [deliveryId], onDelete: Cascade)
  githubRunId                      String?
  githubRunAttempt                 Int?
  githubWorkflowName               String?
  pullRequestNumber                Int?
  commitSha                        String
  baseSha                          String?
  headSha                          String?
  branch                           String?
  comparisonFallback               String?
  failedStage                      String?
  status                           AgentRunStatus        @default(QUEUED)
  skipReason                       String?
  verificationStatus               VerificationStatus    @default(PENDING)
  contextMode                      RepositoryContextMode
  modelProvider                    ModelProvider
  model                            String
  maxRepairAttempts                Int
  rootCause                        String?
  violatedConstraint               String?
  suggestedPatch                   String?
  verifiedPatch                    String?               @db.Text
  patchSha256                      String?
  verifiedAgainstCommitSha         String?
  patchAffectedFiles               Json?
  patchTerraformFilesOnly          Boolean?
  patchExistingFilesOnly           Boolean?
  patchRepositoryRelative          Boolean?
  patchSourceFingerprint           String?
  patchCandidateSource             String?
  mutationEligible                 Boolean?
  mutationEligibilityLevel         String?
  mutationEligibilityReason        String?
  mutationEligibilityDetails       Json?
  verificationOutcome              String?
  assessmentPatchCheckPassed       Boolean?
  assessmentPatchApplyPassed       Boolean?
  assessmentFmtPassed              Boolean?
  assessmentInitPassed             Boolean?
  assessmentValidatePassed         Boolean?
  assessmentPlanAttempted          Boolean?
  assessmentPlanPassed             Boolean?
  assessmentFullVerificationPassed Boolean?
  applySafety                      String?
  planFailureClass                 String?
  planFailureReasonCode            String?
  planFailureSummary               String?
  planFailureDetail                String?
  planFailureSourceFile            String?
  planFailureSourceLine            Int?
  planFailureResourceAddress       String?
  planDiagnosticFormat             String?
  affectedResources                Json?
  modelConfidence                  Float?
  evidenceScore                    Float?
  attempts                         Json?
  timing                           Json?
  tokenUsage                       Json?
  llmCalls                         Json?
  verificationDetails              Json?
  safeResultPayload                Json?
  eventMetadata                    Json?
  configSnapshot                   Json
  totalRuntimeMs                   Int?
  inputTokens                      Int?
  cachedInputTokens                Int?
  outputTokens                     Int?
  reasoningTokens                  Int?
  totalTokens                      Int?
  llmCallCount                     Int?
  llmCostUsd                       Decimal?              @db.Decimal(20, 10)
  costComplete                     Boolean?
  tokenCountsComplete              Boolean?
  llmLatencyMs                     Int?
  llmProvider                      String?
  requestedModel                   String?
  reportedModel                    String?
  upstreamProvider                 String?
  routingMode                      String?
  maxModelTier                     String?
  initialModel                     String?
  finalModel                       String?
  initialModelTier                 String?
  finalModelTier                   String?
  modelEscalated                   Boolean?
  initialContextLevel              String?
  finalContextLevel                String?
  contextEscalated                 Boolean?
  contextEscalationReason          String?
  schemaRetrieved                  Boolean?
  schemaAvoided                    Boolean?
  sourceCharactersAvailable        Int?
  sourceCharactersSelected         Int?
  sourceReductionRatio             Float?
  schemaCharactersAvailable        Int?
  schemaCharactersSelected         Int?
  schemaReductionRatio             Float?
  failureMemoryStatus              String?
  failureMemoryReused              Boolean?
  freshVerificationPassed          Boolean?
  resolutionSource                 String?
  candidateSource                  String?
  llmCallsAvoided                  Int?
  historicalTokensAvoided          Int?
  historicalCostAvoidedUsd         Decimal?              @db.Decimal(20, 10)
  agentVersion                     String?
  configuredModelRouting           ModelRouting?
  configuredMaxModelTier           ModelTier?
  configuredModelId                String?
  accountAccessLevel               UserAccessLevel?
  modelPolicyVersion               String?
  catalogSyncedAt                  DateTime?
  errorCode                        String?
  errorMessage                     String?
  workerStage                      String                @default("queued")
  heartbeatAt                      DateTime?
  workerId                         String?
  claimedAt                        DateTime?
  startedAt                        DateTime?
  completedAt                      DateTime?
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @updatedAt
  publication                      AgentRunPublication?
  patchApplications                PatchApplication[]

  @@unique([repositoryId, githubRunId, githubRunAttempt])
  @@index([repositoryId, createdAt])
  @@index([createdAt])
  @@index([githubInstallationId])
  @@index([status, createdAt])
  @@index([status, heartbeatAt])
  @@index([verificationStatus, createdAt])
  @@index([modelProvider, createdAt])
  @@index([llmProvider, createdAt])
  @@index([reportedModel, createdAt])
  @@index([commitSha])
  @@index([repositoryId, pullRequestNumber])
  @@index([patchSha256])
  @@index([verificationOutcome, createdAt])
}

model PatchApplication {
  id                             String                 @id @default(cuid())
  agentRunId                     String
  agentRun                       AgentRun               @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  repositoryId                   String
  repository                     Repository             @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  requestedByUserId              String
  requestedByUser                User                   @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  requestedByDisplay             String?
  eligibilityLevel               String?
  verificationOutcomeAtRequest   String?
  conditionalApproval            Boolean                @default(false)
  planFailureClassAtRequest      String?
  planFailureReasonCodeAtRequest String?
  status                         PatchApplicationStatus @default(PENDING)
  stage                          String                 @default("queued")
  patchSha256                    String
  expectedHeadSha                String
  verifiedAgainstCommitSha       String
  affectedFiles                  Json
  terraformDir                   String
  terraformVersion               String
  pullRequestNumber              Int
  headBranch                     String
  headRepositoryFullName         String
  intendedCommitSha              String?
  commitSha                      String?
  commitUrl                      String?
  pullRequestUrl                 String?
  freshVerification              Json?
  errorCode                      String?
  errorMessage                   String?
  workerId                       String?
  claimedAt                      DateTime?
  heartbeatAt                    DateTime?
  startedAt                      DateTime?
  completedAt                    DateTime?
  requestedAt                    DateTime               @default(now())
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt

  @@unique([agentRunId, patchSha256, expectedHeadSha])
  @@index([agentRunId])
  @@index([repositoryId, createdAt])
  @@index([status, createdAt])
  @@index([patchSha256])
}

model ModelCatalogEntry {
  id                       String     @id @default(cuid())
  provider                 String
  modelId                  String
  canonicalSlug            String?
  displayName              String
  description              String?
  tier                     ModelTier?
  enabled                  Boolean    @default(false)
  recommended              Boolean    @default(false)
  available                Boolean    @default(true)
  isFree                   Boolean?
  supportsStructuredOutput Boolean    @default(false)
  supportsJsonFallback     Boolean    @default(false)
  contextLength            Int?
  pricingPromptPerMillion  Decimal?   @db.Decimal(20, 10)
  pricingOutputPerMillion  Decimal?   @db.Decimal(20, 10)
  upstreamProvider         String?
  priority                 Int        @default(100)
  policyVersion            String     @default("terrafix_model_policy_v1")
  lastSeenAt               DateTime
  lastSyncedAt             DateTime
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@unique([provider, modelId])
  @@index([provider])
  @@index([enabled, available])
  @@index([tier, enabled])
  @@index([isFree])
}

model ModelCatalogSync {
  id               String    @id @default(cuid())
  provider         String    @unique
  lastAttemptAt    DateTime?
  lastSuccessfulAt DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  modelsReceived   Int?
  modelsNormalized Int?
  modelsEnabled    Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model AgentRunPublication {
  id                    String            @id @default(cuid())
  agentRunId            String            @unique
  agentRun              AgentRun          @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  repositoryId          String
  repository            Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  pullRequestNumber     Int?
  provider              String            @default("github")
  externalCommentId     String?
  externalCommentNodeId String?
  commentUrl            String?
  status                PublicationStatus @default(PENDING)
  attemptCount          Int               @default(0)
  lastErrorCode         String?
  lastErrorMessage      String?
  skipReason            String?
  redactionWarnings     String[]          @default([])
  workerId              String?
  claimedAt             DateTime?
  nextAttemptAt         DateTime?
  publishedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([status, nextAttemptAt, createdAt])
  @@index([repositoryId, pullRequestNumber, createdAt])
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  deliveryId   String                @unique
  eventName    String
  action       String?
  repositoryId String?
  repository   Repository?           @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  status       WebhookDeliveryStatus @default(RECEIVED)
  outcome      String?
  skipReason   String?
  agentRun     AgentRun?
  receivedAt   DateTime              @default(now())
  processedAt  DateTime?

  @@index([repositoryId, receivedAt])
  @@index([status, receivedAt])
}
