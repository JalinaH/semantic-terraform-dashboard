generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  USER
  ORGANIZATION
}

enum RepositorySelection {
  ALL
  SELECTED
}

enum ContextMode {
  MINIMAL
  SMART
  FULL
}

enum AWSConnectionStatus {
  PENDING
  CONNECTED
  ATTENTION
  DISCONNECTED
}

enum VerificationStatus {
  VERIFIED_FIRST_ATTEMPT
  VERIFIED_AFTER_RETRY
  VERIFICATION_FAILED
  PATCH_REJECTED
  VERIFICATION_UNAVAILABLE
  PENDING
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  githubUserId      String?            @unique
  githubLogin       String?
  avatarUrl         String?
  accounts          Account[]
  sessions          Session[]
  userInstallations UserInstallation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([githubLogin])
}

model GitHubInstallation {
  id                  String              @id @default(cuid())
  installationId      String              @unique
  accountId           String?
  accountLogin        String
  accountType         AccountType
  repositorySelection RepositorySelection
  htmlUrl             String?
  suspendedAt         DateTime?
  userInstallations   UserInstallation[]
  repositories        Repository[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([accountId])
  @@index([accountLogin])
}

model UserInstallation {
  id                   String             @id @default(cuid())
  userId               String
  githubInstallationId String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubInstallation   GitHubInstallation @relation(fields: [githubInstallationId], references: [id], onDelete: Cascade)
  lastVerifiedAt       DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([userId, githubInstallationId])
  @@index([githubInstallationId])
}

model Repository {
  id                 String             @id @default(cuid())
  githubRepositoryId String             @unique
  owner              String
  name               String
  fullName           String             @unique
  defaultBranch      String             @default("main")
  private            Boolean            @default(false)
  archived           Boolean            @default(false)
  accessible         Boolean            @default(true)
  removedAt          DateTime?
  installationId     String
  installation       GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  config             RepositoryConfig?
  awsConnection      AWSConnection?
  agentRuns          AgentRun[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([installationId])
  @@index([installationId, accessible])
  @@index([owner, name])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model RepositoryConfig {
  id                String      @id @default(cuid())
  repositoryId      String      @unique
  repository        Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  enabled           Boolean     @default(true)
  terraformDir      String      @default(".")
  terraformVersion  String?
  model             String      @default("gemini-2.5-pro")
  contextMode       ContextMode @default(SMART)
  maxRepairAttempts Int         @default(1)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model AWSConnection {
  id           String              @id @default(cuid())
  repositoryId String              @unique
  repository   Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  roleArn      String
  region       String
  status       AWSConnectionStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model AgentRun {
  id                  String             @id @default(cuid())
  repositoryId        String
  repository          Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  githubRunId         String?            @unique
  pullRequestNumber   Int?
  commitSha           String
  failedStage         String?
  affectedResource    String?
  contextMode         ContextMode
  verificationStatus  VerificationStatus @default(PENDING)
  modelConfidence     Float?
  evidenceScore       Float?
  totalRuntimeMs      Int?
  inputTokens         Int?
  outputTokens        Int?
  rootCause           String?
  violatedConstraint  String?
  suggestedPatch      String?
  attemptHistory      Json?
  verificationDetails Json?
  safeResultPayload   Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([repositoryId, createdAt])
  @@index([verificationStatus, createdAt])
  @@index([commitSha])
  @@index([repositoryId, pullRequestNumber])
}
